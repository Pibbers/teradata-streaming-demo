/* Demo 5 — Full OTF verification of enriched_positions.
   Shows schema mapping, summary counts, and per-aircraft enrichment results.
   The key demo moment: operator/registration/type columns sourced from
   Teradata aircraft_ref via the Flink JDBC Lookup Join.

   Variables substituted by perl in run_bteq.sh:
     ${TD_HOST}  ${TD_USER}  ${TD_PASSWORD}  ${TD_DATABASE}
*/

.SET ERROROUT STDOUT
.SET WIDTH 200

.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
DATABASE ${TD_DATABASE};

/* Schema: confirms enriched columns are present alongside position data */
HELP TABLE demo_iceberg.demo.enriched_positions;

/* Overall summary */
SELECT COUNT(*)               AS total_rows,
       COUNT(DISTINCT icao24) AS aircraft_seen,
       MIN(ts)                AS first_ts,
       MAX(ts)                AS last_ts
FROM demo_iceberg.demo.enriched_positions;

/* Per-aircraft with enriched reference fields from Teradata */
SELECT
    TRIM(icao24)        AS icao24,
    TRIM(callsign)      AS callsign,
    COUNT(*)            AS positions,
    MAX(registration)   AS registration,
    MAX(aircraft_type)  AS ac_type,
    MAX(operator)       AS operator,
    MAX(country)        AS country
FROM demo_iceberg.demo.enriched_positions
GROUP BY 1, 2
ORDER BY 1;

/* Iceberg snapshot history */
SELECT * FROM TD_SNAPSHOTS(ON demo_iceberg.demo.enriched_positions) AS snap;

.LOGOFF;
.QUIT;
