/* Demo 5 — Create the aircraft reference table in Teradata and seed it with
   10 aircraft matching the synthetic fleet in kafka/producers/adsb_producer.py.
   Used by the Flink JDBC Lookup Join to enrich streaming ADS-B positions.

   Safe to run multiple times: DROP + CREATE ensures a clean slate.
   Error 3807 (object not found on DROP) is suppressed.

   Variables substituted by perl in run_bteq.sh:
     ${TD_HOST}  ${TD_USER}  ${TD_PASSWORD}  ${TD_DATABASE}
*/

.SET ERROROUT STDOUT
.SET WIDTH 200
.SET ERRORLEVEL 3807 SEVERITY 0

.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};
DATABASE ${TD_DATABASE};

DROP TABLE aircraft_ref;

CREATE TABLE aircraft_ref (
    icao24        CHAR(6)       NOT NULL,
    registration  VARCHAR(10),
    aircraft_type VARCHAR(20),
    operator      VARCHAR(50),
    country       VARCHAR(30)
) PRIMARY INDEX (icao24);

INSERT INTO aircraft_ref VALUES ('4ca87a', 'EI-GEK', 'A330-300',  'Aer Lingus',            'Ireland');
INSERT INTO aircraft_ref VALUES ('400a5b', 'G-YMML', 'B777-200',  'British Airways',        'UK');
INSERT INTO aircraft_ref VALUES ('3c4b0f', 'D-AIHE', 'A340-600',  'Lufthansa',              'Germany');
INSERT INTO aircraft_ref VALUES ('3950f2', 'F-HTYB', 'A350-900',  'Air France',             'France');
INSERT INTO aircraft_ref VALUES ('34618a', 'EC-MXV', 'A330-200',  'Iberia',                 'Spain');
INSERT INTO aircraft_ref VALUES ('4841d8', 'PH-BVI', 'B777-200',  'KLM',                    'Netherlands');
INSERT INTO aircraft_ref VALUES ('4b1803', 'HB-JCF', 'A220-300',  'Swiss Int''l Air Lines', 'Switzerland');
INSERT INTO aircraft_ref VALUES ('440a45', 'G-VPOP', 'A350-1000', 'Virgin Atlantic',        'UK');
INSERT INTO aircraft_ref VALUES ('4073d6', 'G-TUIM', 'B787-8',    'TUI Airways',            'UK');
INSERT INTO aircraft_ref VALUES ('3f7062', 'EI-FTP', 'B737-800',  'Ryanair',                'Ireland');

SELECT icao24, registration, aircraft_type, operator, country
FROM aircraft_ref
ORDER BY 1;

.LOGOFF;
.QUIT;
