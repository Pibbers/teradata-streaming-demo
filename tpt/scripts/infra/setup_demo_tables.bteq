/* ============================================================
   Teradata Streaming Demo — One-time Setup Script
   Creates the demo database, shared tables, NOS authorization
   objects, and the DATALAKE object.

   Demo-specific tables managed by the demo's own prepare/setup
   scripts (not here):
     • adsb_positions_06  — Demo 6 prepare.bteq
     • adsb_positions_07  — Demo 7 prepare.bteq
     • aircraft_ref       — Demo 5 tpt/scripts/demo05/setup.bteq

   Variables substituted by perl before piping to BTEQ:
     ${TD_HOST}   ${TD_USER}   ${TD_PASSWORD}
     ${TD_DATABASE}  ${HOST_IP}
     ${MINIO_ROOT_USER}  ${MINIO_ROOT_PASSWORD}

   Usage (from run_setup.sh):
     perl -pe 's/\$\{([^}]+)\}/$ENV{$1}/ge' script | bteq

   Idempotent: safe to re-run; drops and recreates all objects.
============================================================ */

.SET ERROROUT STDOUT
.SET WIDTH 200

/* Suppress "object not found" on DROP and "already exists" on CREATE */
.SET ERRORLEVEL 3807 SEVERITY 0
.SET ERRORLEVEL 5612 SEVERITY 0
.SET ERRORLEVEL 3803 SEVERITY 0

.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};

/* ── 1. Database ─────────────────────────────────────────── */
CREATE DATABASE ${TD_DATABASE} FROM DBC
  AS PERM = 2e9 SPOOL = 2e9;

DATABASE ${TD_DATABASE};

/* ── 2. Demo 1: Product Avro tables ─────────────────────── */
DROP TABLE avro_product_stage;
DROP TABLE avro_product;

/* Staging: raw Avro Object Container File bytes as BLOB.
   Loaded via BTEQ .IMPORT VARTEXT ... AS DEFERRED BY NAME.
   AvroContainerSplit then splits each BLOB into individual DATASET rows. */
CREATE TABLE avro_product_stage
(
  stage_id  INTEGER  NOT NULL,
  container BLOB
)
PRIMARY INDEX (stage_id);

/* Target: DATASET column, one row per Avro record */
CREATE MULTISET TABLE avro_product
(
  container_id  INTEGER,
  avro_obj_id   INTEGER,
  avro          DATASET(2097088000) INLINE LENGTH 64000 STORAGE FORMAT AVRO
)
PRIMARY INDEX (container_id);

/* ── 3. Demo 2: ADS-B positions (streaming target) ───────── */
/* pos_date is a stored DATE column used for PPI — populated   */
/* explicitly by TPT / INSERT as CAST(ts AS DATE)              */
DROP TABLE adsb_positions;

CREATE MULTISET TABLE adsb_positions
(
  icao24        CHAR(6)          NOT NULL,
  callsign      VARCHAR(8),
  pos_date      DATE             NOT NULL,
  latitude      DECIMAL(9,6)     NOT NULL,
  longitude     DECIMAL(10,6)    NOT NULL,
  altitude      INTEGER,
  velocity      DECIMAL(7,2),
  heading       DECIMAL(6,2),
  vertical_rate INTEGER,
  on_ground     BYTEINT          DEFAULT 0,
  squawk        CHAR(4),
  ts            TIMESTAMP(3)     NOT NULL,
  ingest_ts     TIMESTAMP(0)     DEFAULT CURRENT_TIMESTAMP(0)
)
PRIMARY INDEX (icao24)
PARTITION BY RANGE_N(
  pos_date BETWEEN DATE '2024-01-01' AND DATE '2030-12-31' EACH INTERVAL '1' DAY
);

/* ── 4. Demo 3: Weather observations (mini-batch target) ──── */
DROP TABLE weather_obs;

CREATE MULTISET TABLE weather_obs
(
  station_id      CHAR(4)        NOT NULL,
  observation_ts  TIMESTAMP(0)   NOT NULL,
  temperature_c   DECIMAL(5,1),
  wind_speed_kts  SMALLINT,
  wind_direction  SMALLINT,
  visibility_m    INTEGER,
  precipitation_mm DECIMAL(6,2),
  pressure_hpa    DECIMAL(7,1),
  conditions      VARCHAR(10),
  ingest_ts       TIMESTAMP(0)   DEFAULT CURRENT_TIMESTAMP(0)
)
PRIMARY INDEX (station_id, observation_ts);

/* ── 5. Authorization objects ────────────────────────────── */
/* Created inside the demo database (DATABASE ${TD_DATABASE} is active).
   FOREIGN TABLE uses EXTERNAL SECURITY DEFINER TRUSTED, which resolves
   auth objects in the same database as the table — demo_db here.        */
REPLACE AUTHORIZATION minio_nos_auth
AS DEFINER TRUSTED
  USER '${MINIO_ROOT_USER}' PASSWORD '${MINIO_ROOT_PASSWORD}';

/* OTF: Hive Metastore catalog (unauthenticated in this demo) */
REPLACE AUTHORIZATION hms_catalog_auth
AS INVOKER TRUSTED
  USER '' PASSWORD '';

/* OTF: MinIO object store credentials for Iceberg files       */
REPLACE AUTHORIZATION minio_storage_auth
AS INVOKER TRUSTED
  USER '${MINIO_ROOT_USER}' PASSWORD '${MINIO_ROOT_PASSWORD}';

/* ── 6. NOS Foreign Tables (Demo 3) ─────────────────────── */
/* These are created after data arrives — see Demo 3 run.sh  */
/* Placeholder comment only; run.sh executes these dynamically */

/* ── 7. DATALAKE object for Iceberg OTF (Demos 4 & 5) ───── */
/* DATALAKE is created after Demo 4 populates Iceberg          */
/* See demos/04-kafka-flink-iceberg/run.sh                    */

.LOGOFF;
.QUIT;
