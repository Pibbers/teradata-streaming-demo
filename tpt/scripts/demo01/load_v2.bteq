/* Demo 1 – load product_v2.avro into the BLOB staging table.
   Uses BTEQ DEFERRED BY NAME: BTEQ reads the binary file at the path
   listed in load_v2_index.txt and inserts it as a single BLOB row.
   AvroContainerSplit (demo01_decode.bteq) will expand this into 30 DATASET rows. */
.SET ERROROUT STDOUT
.SET WIDTH 200

.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};

DATABASE ${TD_DATABASE};

.IMPORT VARTEXT FILE /tpt/data/sample/load_v2_index.txt
USING (c1 BLOB AS DEFERRED BY NAME)
INSERT INTO avro_product_stage (stage_id, container) VALUES (2, :c1);

.LOGOFF;
.QUIT;
