/* ============================================================
   Create demo database and tables in Teradata.
   Run once before executing any demo.
   Usage: bteq < setup_demo_tables.bteq
============================================================ */

.SET ERROROUT STDOUT
.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};

/* ── Database ─────────────────────────────────────────────── */
CREATE DATABASE ${TD_DATABASE} FROM DBC
  AS PERM = 1e9
  SPOOL = 1e9;

DATABASE ${TD_DATABASE};

/* ── Demo 1: Avro BLOB staging table ─────────────────────── */
CREATE TABLE avro_blob_stage
(
  row_id      INTEGER GENERATED ALWAYS AS IDENTITY,
  load_ts     TIMESTAMP(0) DEFAULT CURRENT_TIMESTAMP,
  source_file VARCHAR(255),
  payload     BLOB                          /* raw Avro bytes */
)
PRIMARY INDEX (row_id);

CREATE TABLE avro_blob_stage_log  (ERRORCODE INTEGER, ERRORTXT  VARCHAR(4096));
CREATE TABLE avro_blob_stage_err1 (row_id INTEGER, ErrorCode INTEGER, ErrorField VARCHAR(64));
CREATE TABLE avro_blob_stage_err2 (row_id INTEGER, ErrorCode INTEGER, ErrorField VARCHAR(64));

/* ── Demo 2: Kafka streaming target ──────────────────────── */
CREATE TABLE sensor_events
(
  event_id    CHAR(36),
  device_id   VARCHAR(20),
  event_type  VARCHAR(20),
  value       FLOAT,
  unit        VARCHAR(10),
  location    VARCHAR(50),
  ts          TIMESTAMP(3),
  quality     BYTEINT
)
PRIMARY INDEX (device_id);

/* ── Demo 5: Reference lookup table (enrichment) ────────── */
CREATE TABLE device_registry
(
  device_id    VARCHAR(20),
  device_name  VARCHAR(100),
  owner        VARCHAR(100),
  install_date DATE,
  site_code    CHAR(8)
)
PRIMARY INDEX (device_id);

/* Seed some reference data */
INSERT INTO device_registry VALUES ('device-001', 'Sensor Alpha',   'Operations',  '2023-01-15', 'PLANT-A ');
INSERT INTO device_registry VALUES ('device-002', 'Sensor Beta',    'Maintenance', '2023-02-01', 'PLANT-A ');
INSERT INTO device_registry VALUES ('device-003', 'Sensor Gamma',   'Operations',  '2023-03-10', 'PLANT-B ');
INSERT INTO device_registry VALUES ('device-004', 'Sensor Delta',   'Maintenance', '2023-04-22', 'PLANT-B ');
INSERT INTO device_registry VALUES ('device-005', 'Sensor Epsilon', 'Engineering', '2023-05-05', 'DOCK-3  ');

.LOGOFF;
.QUIT;
