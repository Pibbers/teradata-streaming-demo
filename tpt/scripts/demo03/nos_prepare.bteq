/* Demo 3 – pre-run: drop the NOS foreign table so it can be recreated
   with the current PATHPATTERN settings.  weather_obs rows are left
   intact (accumulative mode); use demo03_nos_fresh.bteq for a full reset. */
.SET ERROROUT STDOUT
.SET ERRORLEVEL 3807 SEVERITY 0
.SET ERRORLEVEL 5612 SEVERITY 0

.LOGON ${TD_HOST}/${TD_USER},${TD_PASSWORD};

DATABASE ${TD_DATABASE};

DROP TABLE weather_nos_ft;

.LOGOFF;
.QUIT;
