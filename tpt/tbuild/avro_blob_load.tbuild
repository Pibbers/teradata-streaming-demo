/*=============================================================
  Demo 1A: Load Avro container files as BLOBs into Teradata
  using the TPT STREAM operator + DataConnector.

  Input: a two-line manifest (written by generate_product_avro.py):
    1|/tpt/data/sample/product_v1.avro
    2|/tpt/data/sample/product_v2.avro

  The correct TPT schema syntax for file-path-based LOB loading is:
    BLOB(size) AS DEFERRED BY NAME
  NOT "BLOB BY NAME" (BTEQ syntax) and NOT plain "BLOB" (rejected by
  DataConnector for DELIMITED format).  Source: TPT sample PTS00025.

  DataConnector DELIMITED format reads column 1 (stage_id) as a VARCHAR
  and column 2 (container) as a file path; the operator opens each file
  and streams its bytes as the BLOB value.

  stage_id is declared VARCHAR(10) because DELIMITED format requires all
  schema columns to be VARCHAR or a LOB AS DEFERRED BY NAME type.
  It is CAST to INTEGER in the INSERT statement.

  STREAM is used (not LOAD/FastLoad/MLoad) because it is the only
  high-throughput TPT operator that supports BLOB/CLOB target columns.

  Variables substituted by run_tbuild.sh:
    TD_HOST  TD_USER  TD_PASSWORD  TD_DATABASE  MANIFEST_FILE
=============================================================*/

DEFINE JOB AVRO_BLOB_LOAD
DESCRIPTION 'Load Avro container files as BLOBs into avro_product_stage via manifest'
(
  DEFINE SCHEMA AVRO_LOB_SCHEMA
  (
    stage_id   VARCHAR(10),
    container  BLOB(10000000) AS DEFERRED BY NAME
  );

  DEFINE OPERATOR FILE_READER
  TYPE DATACONNECTOR PRODUCER
  SCHEMA AVRO_LOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR FileName         = '$(MANIFEST_FILE)',
    VARCHAR Format           = 'Delimited',
    VARCHAR TextDelimiter    = '|',
    VARCHAR OpenMode         = 'Read'
  );

  DEFINE OPERATOR TD_INSERTER
  TYPE STREAM
  SCHEMA AVRO_LOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR TdpId            = '$(TD_HOST)',
    VARCHAR UserName         = '$(TD_USER)',
    VARCHAR UserPassword     = '$(TD_PASSWORD)',
    VARCHAR TargetTable      = '$(TD_DATABASE).avro_product_stage',
    VARCHAR PrivateLogName   = 'avro_blob_stream_log',
    VARCHAR LogTable         = '$(TD_DATABASE).avro_blob_stream_log_tbl',
    VARCHAR ErrorTable       = '$(TD_DATABASE).avro_blob_stream_err_tbl'
  );

  APPLY
  (
    'INSERT INTO $(TD_DATABASE).avro_product_stage (stage_id, container)
     VALUES (CAST(:stage_id AS INTEGER), :container);'
  )
  TO OPERATOR (TD_INSERTER)
  SELECT * FROM OPERATOR (FILE_READER);
);
