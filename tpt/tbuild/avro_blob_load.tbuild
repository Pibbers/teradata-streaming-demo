/*=============================================================
  Demo 1: Load Avro file as BLOB into Teradata
  Reads sample.avro and inserts raw bytes into a staging table.
  After load, use avro_blob_decode.sql to read the BLOB back
  using DATASET STORAGE FORMAT AVRO.
=============================================================*/

DEFINE JOB AVRO_BLOB_LOAD
DESCRIPTION 'Load Avro file as BLOB into Teradata staging table'
(
  DEFINE SCHEMA AVRO_BLOB_SCHEMA
  (
    payload  VARBYTE(2097088)  -- up to ~2 MB per row
  );

  DEFINE OPERATOR FILE_READER
  TYPE DATACONNECTOR PRODUCER
  SCHEMA AVRO_BLOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR FileName         = '$(AVRO_FILE)',
    VARCHAR Format           = 'binary',
    VARCHAR OpenMode         = 'Read'
  );

  DEFINE OPERATOR TD_LOADER
  TYPE LOAD
  SCHEMA AVRO_BLOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR TdpId            = '$(TD_HOST)',
    VARCHAR UserName         = '$(TD_USER)',
    VARCHAR UserPassword     = '$(TD_PASSWORD)',
    VARCHAR TargetTable      = '$(TD_DATABASE).avro_blob_stage',
    VARCHAR LogTable         = '$(TD_DATABASE).avro_blob_stage_log',
    VARCHAR ErrorTable1      = '$(TD_DATABASE).avro_blob_stage_err1',
    VARCHAR ErrorTable2      = '$(TD_DATABASE).avro_blob_stage_err2'
  );

  APPLY
  (
    'INSERT INTO $(TD_DATABASE).avro_blob_stage (load_ts, source_file, payload)
     VALUES (CURRENT_TIMESTAMP, ''$(AVRO_FILE)'', :payload);'
  )
  TO OPERATOR (TD_LOADER)
  SELECT * FROM OPERATOR (FILE_READER);
);
