/*=============================================================
  Demo 1: Load an Avro container file as BLOB into Teradata
  using the TPT STREAM operator + DataConnector LOBCOLS.

  Input: a single-line index file (generated by generate_product_avro.py):
    <display_name>|<absolute_path_to_avro_file>

  DataConnector reads the path in the second (LOBCOLS) field and
  sends the raw file bytes to the STREAM operator, which INSERTs
  them into the BLOB column.  Using STREAM (not LOAD/FastLoad)
  because STREAM supports BLOB, IDENTITY, and DEFAULT columns.

  Variables substituted by run_tbuild.sh:
    TD_HOST  TD_USER  TD_PASSWORD  TD_DATABASE  INDEX_FILE
=============================================================*/

DEFINE JOB AVRO_BLOB_LOAD
DESCRIPTION 'Stream one Avro container file as BLOB into avro_product_stage'
(
  DEFINE SCHEMA AVRO_LOB_SCHEMA
  (
    source_file  VARCHAR(255),
    container    BLOB BY NAME   /* DataConnector reads path from index file; sends bytes to BLOB column */
  );

  DEFINE OPERATOR FILE_READER
  TYPE DATACONNECTOR PRODUCER
  SCHEMA AVRO_LOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR FileName         = '$(INDEX_FILE)',
    VARCHAR Format           = 'Delimited',
    VARCHAR TextDelimiter    = '|',
    VARCHAR OpenMode         = 'Read'
  );

  DEFINE OPERATOR TD_INSERTER
  TYPE STREAM
  SCHEMA AVRO_LOB_SCHEMA
  ATTRIBUTES
  (
    VARCHAR TdpId            = '$(TD_HOST)',
    VARCHAR UserName         = '$(TD_USER)',
    VARCHAR UserPassword     = '$(TD_PASSWORD)',
    VARCHAR TargetTable      = '$(TD_DATABASE).avro_product_stage',
    VARCHAR PrivateLogName   = 'avro_blob_stream_log'
  );

  APPLY
  (
    'INSERT INTO $(TD_DATABASE).avro_product_stage (source_file, container)
     VALUES (:source_file, :container);'
  )
  TO OPERATOR (TD_INSERTER)
  SELECT * FROM OPERATOR (FILE_READER);
);
