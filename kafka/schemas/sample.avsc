{
  "type": "record",
  "name": "SensorEvent",
  "namespace": "com.teradata.demo",
  "doc": "IoT sensor event — used across all streaming demos",
  "fields": [
    {"name": "event_id",   "type": "string",  "doc": "UUID for the event"},
    {"name": "device_id",  "type": "string",  "doc": "Source device identifier"},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["TEMPERATURE", "PRESSURE", "HUMIDITY", "VIBRATION"]}},
    {"name": "value",      "type": "double",  "doc": "Sensor reading"},
    {"name": "unit",       "type": "string",  "doc": "Unit of measurement"},
    {"name": "location",   "type": "string",  "doc": "Physical location of device"},
    {"name": "ts",         "type": "long",    "logicalType": "timestamp-millis", "doc": "Event timestamp in epoch milliseconds"},
    {"name": "quality",    "type": ["null", "int"], "default": null, "doc": "Optional quality score 0-100"}
  ]
}
